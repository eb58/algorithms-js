{
   "name": "algorithms-js-eb",
   "version": "1.0.0",
   "keywords": [
      "permutations",
      "combinations",
      "magic squares",
      "sorting",
      "sudoku"
   ],
   "jest": {
      "//": "Comment goes here",
      "verbose": true,
      "collectCoverageFrom": [
         "src/complex/**/*.js"
      ]
   },
   "author": "eb",
   "contributors": [],
   "scripts": {
      "ts-test": "tsc &&  node ./ts-built/test.js",
      "index-card-app": "tsc",
      "test": "jest --runInBand --watchAll=false",
      "test:watch": "jest --watchAll",
      "test:coverage": "jest --coverage --runInBand --watchAll=false",
      "debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
      "sudoku": "node src/sudoku/sudoku3.js",
      "complex": "node src/complex/complex.js",
      "pentomino": "node --inspect src/pentomino/pentomino.js"
   },
   "dependencies": {
      "@algorithm.ts/dlx": "^4.0.3",
      "dancing-links": "^2.1.1",
      "dlx": "^0.2.1",
      "dlxlib": "^1.0.3",
      "mathjs": "^14.6.0",
      "plotly": "^1.0.6"
   },
   "devDependencies": {
      "jest": "30.4.0",
      "prettier": "3.6.2",
      "typescript": "^5.8.3"
   }
}
